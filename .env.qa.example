# See docs/QA_ENVIRONMENT.md for setup and safety rules.

FAMY_ENV=qa
FAMY_QA_SUPABASE_PROJECT_REF=
FAMY_PRODUCTION_SUPABASE_PROJECT_REF=
QA_SUPABASE_URL=
QA_SUPABASE_PUBLISHABLE_KEY=
QA_SUPABASE_SECRET_KEY=
FAMY_QA_APP_ORIGIN=
FAMY_PRODUCTION_APP_ORIGIN=

# OTP delivery provider for QA/local E2E (mock | meta | firebase)
OTP_PROVIDER=
VITE_OTP_PROVIDER=

# Firebase Phone Auth — client (public; required when OTP_PROVIDER/VITE_OTP_PROVIDER=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Phone Auth — server (secret; required when OTP_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# For OTP_PROVIDER/VITE_OTP_PROVIDER=firebase E2E, add Firebase Console test phone
# numbers (Authentication → Sign-in method → Phone → Phone numbers for testing).
