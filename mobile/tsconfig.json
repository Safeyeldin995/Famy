{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@shared/*": [
        "../src/lib/*"
      ],
      "@/lib/pricing/servicePackages": [
        "../src/lib/pricing/servicePackages"
      ],
      "@/lib/tutoring/teachingCapabilities": [
        "../src/lib/tutoring/teachingCapabilities"
      ],
      "@/lib/tutoring/studentEducationProfile": [
        "../src/lib/tutoring/studentEducationProfile"
      ],
      "@/lib/booking/childAgeMonths": [
        "../src/lib/booking/childAgeMonths"
      ],
      "@/lib/booking/timeWindow": [
        "../src/lib/booking/timeWindow"
      ],
      "@/lib/booking/sessionLifecycle": [
        "../src/lib/booking/sessionLifecycle"
      ],
      "@supabase/supabase-js": [
        "./node_modules/@supabase/supabase-js"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vitest.config.ts",
    "tsconfig.vitest.json"
  ]
}
