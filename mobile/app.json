{
  "expo": {
    "name": "Famy",
    "slug": "famy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "famy",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.famy.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Famy uses your location while the app is open to pin your service address on the map. We do not track your location in the background.",
        "NSPhotoLibraryUsageDescription": "Famy lets you choose photos from your library for your profile picture, payment receipt uploads, and provider verification documents (such as ID). The app does not access your camera or microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F10E72",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.famy.app",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F10E72",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Famy uses your location while the app is open to pin your service address on the map. We do not track your location in the background."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Famy lets you choose photos from your library for your profile picture, payment receipt uploads, and provider verification documents (such as ID). The app does not access your camera or microphone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F10E72"
        }
      ],
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.4.0",
            "extraProguardRules": "# Room instantiates generated databases (e.g. WorkManager's WorkDatabase_Impl) by reflection.\n-keep class * extends androidx.room.RoomDatabase {\n    public <init>();\n}"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supportsRTL": true,
      "scheme": "famy",
      "oauthProviders": "google",
      "supabaseUrl": "https://mjhkaiabfnzewprcnojp.supabase.co",
      "supabasePublishableKey": "sb_publishable_D64qG4N5jldifQODMKizXQ_F5_095-H",
      "webOrigin": "https://famy-chi.vercel.app",
      "eas": {
        "projectId": "bda0cf9d-2193-4fbf-aacf-9907d69a667d"
      }
    },
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "owner": "safeyeldin"
  }
}
