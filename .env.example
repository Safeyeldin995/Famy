# Push notifications (Patch 3 / Module 4). Public VAPID key only — the
# private key is a Supabase secret (VAPID_PRIVATE_KEY), never an env var
# here and never committed. Leave blank to keep push notifications in
# their honest "not available yet" state.
VITE_VAPID_PUBLIC_KEY=

# OTP delivery provider: mock | meta | http_sms | firebase
OTP_PROVIDER=
VITE_OTP_PROVIDER=

# Generic HTTP SMS OTP (server-only; required when OTP_PROVIDER=http_sms)
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_AUTH_VALUE=
SMS_HTTP_BODY_TEMPLATE=
SMS_SENDER_ID=
SMS_MESSAGE_TEMPLATE_AR=
SMS_MESSAGE_TEMPLATE_EN=
SMS_MESSAGE_LANG=ar
# Optional: require a JSON field match (dot path) in addition to 2xx
SMS_HTTP_SUCCESS_JSONPATH=
SMS_HTTP_SUCCESS_VALUE=
SMS_HTTP_TIMEOUT_MS=15000

# Google Maps (browser key for web Vite build; restrict by HTTP referrer)
VITE_GOOGLE_MAPS_BROWSER_KEY=

# OAuth sign-in buttons (comma-separated: google, apple). Leave blank to hide until
# Google/Apple providers are enabled in Supabase Auth.
VITE_OAUTH_PROVIDERS=

# Meta WhatsApp OTP (server-only; required when OTP_PROVIDER=meta)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANGUAGE=
META_WHATSAPP_TEMPLATE_BUTTON_TYPE=

# Firebase Phone Auth — client (public)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Phone Auth — server (secret; required when OTP_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Signed auth-intent cookies for OTP/password-setup flows (server-only)
AUTH_INTENT_SECRET=

# Paymob Egypt online payments (server-only; never VITE_-prefixed)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
# Optional override; defaults to ${SUPABASE_URL}/functions/v1/paymob-webhook
PAYMOB_NOTIFICATION_URL=
